# Bible Daily Environment Variables
# Copy this file to .env and fill in your values

# ESV API (https://api.esv.org/) - Free tier: 500 requests/day
# Get your key at: https://api.esv.org/signup/
ESV_API_KEY=

# API.Bible by Faithlife (https://scripture.api.bible/) - Free tier: 5000 requests/month
# Get your key at: https://scripture.api.bible/
API_BIBLE_KEY=

# VAPID Keys for Push Notifications (generate with: npx web-push generate-vapid-keys)
# Public key goes here, private key should be kept secret on server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bibledaily.app

# Analytics (optional)
# PLAUSIBLE_DOMAIN=bibledaily.app
# PLAUSIBLE_API_HOST=https://plausible.io

# Feature flags
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=false