---
import MainLayout from '@/layouts/MainLayout.astro';
import { Header } from '@/components/layout/Header';
import { Footer } from '@/components/layout/Footer';
import { Button } from '@/components/ui/Button';
import { Home, Search, BookOpen } from 'lucide-react';
---

<MainLayout title="Page Not Found - Bible Daily" description="The page you're looking for doesn't exist.">
  <slot name="header">
    <Header client:load />
  </slot>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center">
      <div class="text-8xl mb-6">📖</div>
      <h1 class="text-4xl font-serif font-bold text-gray-900 dark:text-white mb-4">
        Page Not Found
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved. 
        But don't worry - God's Word is always available.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl font-semibold hover:bg-primary-700 transition-colors">
          <Home className="h-5 w-5" />
          Go Home
        </a>
        <a href="/prayers" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-primary-600 text-primary-600 rounded-xl font-semibold hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors">
          <BookOpen className="h-5 w-5" />
          Browse Prayers
        </a>
        <a href="/topics" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 rounded-xl font-semibold hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
          <Search className="h-5 w-5" />
          Search Topics
        </a>
      </div>
    </div>
  </div>

  <slot name="footer">
    <Footer />
  </slot>
</MainLayout>