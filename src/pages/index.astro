---
import MainLayout from '@/layouts/MainLayout.astro';
import DailyVerseDisplay from '@/components/features/DailyVerse';
import TopicCard from '@/components/features/TopicCard';
import { Header } from '@/components/layout/Header';
import { Footer } from '@/components/layout/Footer';
import topicsData from '@/content/prayers/topics.json';
---

<MainLayout title="Bible Daily - Daily Verse & Prayers" description="Start your day with God's Word. Daily Bible verses, topic-based prayers, and reading plans in your language.">
  <slot name="header">
    <Header client:load />
  </slot>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Hero Section -->
    <section class="mb-12" aria-labelledby="hero-heading">
      <div class="relative rounded-3xl bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 p-8 sm:p-12 lg:p-16 overflow-hidden">
        <div class="absolute inset-0 opacity-10">
          <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <defs>
              <pattern id="cross-pattern" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M10 0 L10 20 M0 10 L20 10" stroke="white" stroke-width="0.5" />
              </pattern>
            </defs>
            <rect width="100" height="100" fill="url(#cross-pattern)" />
          </svg>
        </div>
        
        <div class="relative z-10 max-w-2xl">
          <h1 id="hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold text-white mb-4 leading-tight">
            Daily Bread for Your Soul
          </h1>
          <p class="text-lg sm:text-xl text-primary-100 mb-8 max-w-xl leading-relaxed">
            Start each day with God's living Word. Discover prayers for every season of life. Grow deeper in faith, one verse at a time.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/prayers" class="px-6 py-3 bg-white text-primary-700 rounded-xl font-semibold hover:bg-primary-50 transition-colors shadow-lg">
              Explore Prayers
            </a>
            <a href="/topics" class="px-6 py-3 border-2 border-white text-white rounded-xl font-semibold hover:bg-white/10 transition-colors">
              Browse Topics
            </a>
          </div>
        </div>

        <div class="absolute bottom-0 right-0 opacity-20">
          <svg class="w-72 h-72" viewBox="0 0 100 100" preserveAspectRatio="none">
            <text x="50" y="55" font-family="Georgia, serif" font-size="80" font-weight="bold" text-anchor="middle" fill="white">📖</text>
          </svg>
        </div>
      </div>
    </section>

    <!-- Daily Verse Section -->
    <section class="mb-12" aria-labelledby="daily-verse-heading">
      <div class="flex items-center justify-between mb-6">
        <h2 id="daily-verse-heading" class="text-2xl sm:text-3xl font-serif font-bold text-gray-900 dark:text-white">
          Verse of the Day
        </h2>
        <a href="/verse" class="text-primary-600 dark:text-primary-400 hover:underline text-sm font-medium">
          View All →
        </a>
      </div>
      <DailyVerseDisplay client:visible />
    </section>

    <!-- Popular Prayer Topics -->
    <section class="mb-12" aria-labelledby="topics-heading">
      <div class="flex items-center justify-between mb-6">
        <h2 id="topics-heading" class="text-2xl sm:text-3xl font-serif font-bold text-gray-900 dark:text-white">
          Popular Prayer Topics
        </h2>
        <a href="/topics" class="text-primary-600 dark:text-primary-400 hover:underline text-sm font-medium">
          View All →
        </a>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {topicsData.topics.slice(0, 8).map((topic: any) => (
          <TopicCard
            key={topic.id}
            topic={topic}
            variant="default"
            client:visible
          />
        ))}
      </div>
    </section>

    <!-- Features -->
    <section class="mb-12" aria-labelledby="features-heading">
      <h2 id="features-heading" class="sr-only">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <FeatureCard
          icon="📖"
          title="Daily Verses"
          description="Fresh Scripture every morning, curated from the lectionary. Available in multiple translations."
        />
        <FeatureCard
          icon="🙏"
          title="Topic-Based Prayers"
          description="Over 100 prayers organized by topic: healing, anxiety, guidance, relationships, and more."
        />
        <FeatureCard
          icon="🌍"
          title="Your Language"
          description="Auto-detects your language (Hindi, English, and more coming). Read God's Word in your heart language."
        />
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center" aria-labelledby="cta-heading">
      <h2 id="cta-heading" class="sr-only">Get Started</h2>
      <div class="inline-block px-8 py-12 rounded-2xl bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
        <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-3">
          Ready to Go Deeper?
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-md mx-auto">
          Join thousands growing in faith daily. Add to home screen for offline access and daily notifications.
        </p>
        <a href="/prayers" class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl font-semibold hover:bg-primary-700 transition-colors">
          Start Praying Now
        </a>
      </div>
    </section>
  </div>

  <slot name="footer">
    <Footer />
  </slot>
</MainLayout>

<script>
  function FeatureCard({ icon, title, description }) {
    return (
      <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 hover:shadow-card hover:border-primary-200 dark:hover:border-primary-800 transition-all text-center">
        <div class="text-4xl mb-4">{icon}</div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">{title}</h3>
        <p class="text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    );
  }
</script>